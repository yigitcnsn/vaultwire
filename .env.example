# Required: API key from Obsidian → Settings → Local REST API
OBSIDIAN_API_KEY=your-api-key-here

# Optional: Local REST API base URL (HTTPS default; use http://127.0.0.1:27123 for insecure mode)
OBSIDIAN_BASE_URL=https://127.0.0.1:27124

# Optional: set to "true" to allow self-signed TLS certs on non-localhost hosts
# OBSIDIAN_ALLOW_INSECURE_SSL=true
