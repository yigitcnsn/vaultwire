{
  "name": "vaultwire",
  "version": "1.0.1",
  "description": "MCP server that lets Claude read and write Obsidian notes via the Local REST API plugin",
  "type": "module",
  "bin": {
    "vaultwire": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "claude",
    "model-context-protocol",
    "local-rest-api",
    "notes"
  ],
  "author": "Ahmet Yiğitcan ŞEN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yigitcnsn/vaultwire.git"
  },
  "bugs": {
    "url": "https://github.com/yigitcnsn/vaultwire/issues"
  },
  "homepage": "https://github.com/yigitcnsn/vaultwire#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "undici": "^7.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
